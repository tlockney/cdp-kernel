{
  "name": "@tlockney/cdp-kernel",
  "version": "0.7.0",
  "description": "Deno's Jupyter kernel, extracted to run notebooks on Node, Deno, Bun, workerd and celld",
  "license": "MIT",
  "author": "Thomas Lockney <thomas@lockney.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tlockney/cdp-kernel.git"
  },
  "keywords": [
    "jupyter",
    "kernel",
    "typescript",
    "notebook",
    "deno",
    "node",
    "cdp",
    "devtools-protocol"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "cdp-kernel": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./globals": {
      "types": "./dist/globals.d.ts",
      "default": "./dist/globals.js"
    },
    "./browser": {
      "types": "./dist/browser/mod.d.ts",
      "default": "./dist/browser/kernel.js"
    },
    "./browser/worker": "./dist/browser/worker.js",
    "./globals/deno-compat": {
      "types": "./dist/globals-deno-compat.d.ts",
      "default": "./dist/globals-deno-compat.js"
    }
  },
  "files": [
    "dist/",
    "runtime/*.mjs",
    "runtime/*.d.mts",
    "THIRD-PARTY-NOTICES"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-browser.mjs dist/browser",
    "check": "tsc -p tsconfig.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:notebooks": "node docs/.vitepress/run-notebooks.ts",
    "docs:widgets": "uv run --with jupyterlab --with anywidget --with playwright --with nbformat python test/widget_screenshots.py",
    "install:node": "node src/main.ts install --runtime node",
    "install:deno": "node src/main.ts install --runtime deno",
    "install:node-deno": "node src/main.ts install --runtime node --deno-compat",
    "install:bun": "node src/main.ts install --runtime bun",
    "install:workerd": "node src/main.ts install --runtime workerd",
    "install:celld": "node src/main.ts install --runtime celld",
    "prepack": "npm run build",
    "test": "node --test --test-timeout=300000 test/*.test.ts",
    "e2e": "uv run --with nbclient --with nbformat --with jupyter_client python test/e2e.py",
    "bench": "uv run --with jupyter_client python test/bench.py",
    "soak": "uv run --with jupyter_client python test/soak.py",
    "test:lab": "uv run --with jupyterlab --with anywidget --with playwright --with nbformat python test/lab_widgets.py"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "esbuild": "^0.25.10",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "medium-zoom": "^1.1.0",
    "vitepress": "^1.6.4",
    "workerd": "1.20261015.1",
    "wrangler": "4.151.0"
  },
  "optionalDependencies": {
    "sucrase": "^3.35.1"
  }
}
